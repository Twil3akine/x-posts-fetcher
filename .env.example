# Copy this file to ".env" and fill in your own values.
# Never commit your real .env (it is listed in .gitignore).

# App Bearer Token from the X Developer Portal (required).
X_BEARER_TOKEN=your_bearer_token_here

# Usernames to fetch, comma-separated, without "@" (required).
X_ACCOUNTS=account1,account2

# Timezone used for the default "previous day" window (optional).
TZ=Asia/Tokyo
